[resource]
script = ExtResource("11")
id = &"cinder_crab"
display_name = "Cinder Crab"
lore = "A rust-red crab of the tide rocks that scavenges sea kelp, clams and the ember-root that washes down off the cliff. The root's coal gathers in its meat: cooked, a crab claw stays hot in the hand."
habitat = "The Kelp Shallows, rock crevices"
diet = Array[ExtResource("1")]([ExtResource("3"), ExtResource("4"), ExtResource("5")])
